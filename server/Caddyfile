# 备案期间先走 80 端口；域名下来后把 :80 换成域名，Caddy 自动签 HTTPS。
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /uploads/* {
		root * /srv/uploads
		file_server
	}

	handle {
		root * /srv/web
		file_server
		try_files {path} {path}/ /index.html
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
